      </div>
      <img id="modalImg" src="" alt="" style="display:none;" />
      <h2 id="modalTitle" style="margin:0 0 8px;font-size:20px;"></h2>
      <div class="card-meta" id="modalMeta" style="border:none;padding:0;"></div>
      <div class="modal-text" id="modalDesc"></div>
      <div id="modalActions" class="card-actions" style="margin-top:12px;"></div>
    </div>
  </div>

