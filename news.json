    </div>

    <div class="cats" id="categoryTabs"></div>
    <input type="search" class="search-input" id="searchInput" placeholder="செய்திகள், தலைப்புகள் அல்லது பிரிவுகளைத் தேடவும்..." oninput="applyFilters()" />

